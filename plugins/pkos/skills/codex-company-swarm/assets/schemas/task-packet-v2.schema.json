{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"pkos-company-swarm/task-packet-v2",
  "$defs":{
    "route":{"type":"object","required":["model","reasoning_effort","model_rationale","risk_level"],"properties":{"model":{"type":"string","minLength":1},"reasoning_effort":{"type":"string","minLength":1},"model_rationale":{"type":"string","minLength":1},"risk_level":{"enum":["low","medium","high","critical"]}}},
    "visibleTask":{"allOf":[{"$ref":"#/$defs/route"},{"type":"object","required":["session_id","threadId","hostId","title","visible_task","transport","role","lane","generation","director_epoch","state","last_cursor","task_packet"],"properties":{"visible_task":{"const":true},"transport":{"const":"visible_codex_task"},"state":{"enum":["registered","queued","active","attention","settled","archived"]},"task_packet":{"allOf":[{"$ref":"#/$defs/route"},{"type":"object","required":["generation","director_epoch","pack_revision","may_delegate"]}]}}}]}
  },
  "allOf":[{"$ref":"#/$defs/route"},{"type":"object","required":["generation","director_epoch","pack_revision","may_delegate"]}]
}
